# ============================================================================
# AlphaScout Environment Configuration Template
# Never commit real API keys or secrets. All production secrets are fetched
# dynamically from Google Cloud Secret Manager (see alphascout/config.py).
# ============================================================================

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=sianiltestprj-sandbox-970332
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Search Datastore ID for SEC 10-K / 10-Q Filings
VERTEX_SEARCH_DATASTORE_ID=alphascout-sec-filings-datastore

# Secret Manager Secret IDs (loaded via google.cloud.secretmanager_v1)
ALPACA_API_KEY_SECRET_ID=alphascout-alpaca-paper-api-key
ALPACA_SECRET_KEY_SECRET_ID=alphascout-alpaca-paper-secret-key
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Observability & Telemetry
OTEL_SERVICE_NAME=alphascout-equity-research-agent
ENABLE_CLOUD_DLP_REDACTION=true
MAX_CONTEXT_TOKENS=8000
SLIDING_WINDOW_TURNS=10
